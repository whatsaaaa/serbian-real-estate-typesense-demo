# Copy this file to .env and fill it in. .env stays out of git.

# The admin key Typesense starts with (docker-compose.yml), which the seed script and the app use
TYPESENSE_API_KEY=
# Where the seed script and the app reach Typesense
TYPESENSE_URL=http://localhost:8108

# Your Anthropic API key. The seed script gives it to Typesense's natural language search model,
# which calls Claude with it. The app never sees it.
ANTHROPIC_API_KEY=
