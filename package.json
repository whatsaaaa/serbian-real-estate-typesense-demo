{
  "name": "serbian-real-estate-typesense-demo",
  "private": true,
  "description": "A one-page Nuxt demo of Typesense natural-language search on Serbian real estate listings",
  "license": "MIT",
  "author": "Whatsaaaa",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "generate:listings": "node scripts/generate-listings.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "eval": "node --env-file-if-exists=.env scripts/eval.ts",
    "type-check": "nuxt typecheck",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:css": "stylelint \"**/*.{css,vue}\" --fix --allow-empty-input",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.160",
    "@nuxt/ui": "~4.13.1",
    "@whatsaaaa/design-system": "^1.1.0",
    "@whatsaaaa/ui-vue": "^0.2.0",
    "nuxt": "^4.7.0",
    "tailwindcss": "^4.3.5",
    "typesense": "^3.3.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@whatsaaaa/eslint-config": "^1.0.0",
    "@whatsaaaa/format-config": "^1.0.0",
    "@whatsaaaa/oxlint-config": "^1.0.0",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.1.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "postcss-html": "^2.0.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.21.0"
}
